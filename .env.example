# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=30
# Gmail OAuth (Google Cloud Console → Credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL; redirect URI = PUBLIC_URL/auth/google/callback
PUBLIC_URL=http://localhost:8000
# Long random string used to encrypt session cookies
SESSION_SECRET=
